FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

solver          incompressibleFluid;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         0.05;

deltaT          0.00001;

adjustTimeStep  yes;
maxCo           0.7;
maxDeltaT       0.001;

writeControl    runTime;
writeInterval   0.0025;

purgeWrite      0;

writeFormat     binary;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;
