FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0";
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-05;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1e-05;
    }
    outlet
    {
        type            zeroGradient;
    }
    domainWalls
    {
        type            zeroGradient;
    }
    SrocketMeshMin.stl
    {
        type            fixedValue;
        value           uniform 0;
    }
}


